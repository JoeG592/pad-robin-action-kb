DateTime.GetCurrentDateTime.Local DateTimeFormat: DateTime.DateTimeFormat.DateAndTime CurrentDateTime=> CurrentDateTime
Text.ConvertDateTimeToText.FromCustomDateTime CustomFormat: $'''yyyy-MM''' DateTime: CurrentDateTime Result=> FormattedDateTime
IF (Folder.IfFolderExists.DoesNotExist Path: $'''C:\Reports\\%FormattedDateTime%''') THEN
    Folder.Create FolderPath: $'''C:\Reports''' FolderName: FormattedDateTime Folder=> NewFolder
END
Folder.GetFiles Folder: $'''C:\Invoices''' FileFilter: $'''*.csv''' IncludeSubfolders: False FailOnAccessDenied: True SortBy1: Folder.SortBy.NoSort SortDescending1: False SortBy2: Folder.SortBy.NoSort SortDescending2: False SortBy3: Folder.SortBy.NoSort SortDescending3: False Files=> Files
Variables.CreateNewList List=> Summary
SET InvoiceCount TO 0
Excel.LaunchExcel.Launch UseMachineLocale: False Visible: False LoadAddInsAndMacros: False Instance=> ExcelInstance
Excel.WriteToExcel.WriteCell Instance: ExcelInstance Value: $'''Invoice''' Column: $'''A''' Row: 1
Excel.WriteToExcel.WriteCell Instance: ExcelInstance Value: $'''Line items''' Column: $'''B''' Row: 1
LOOP FOREACH CurrentItem IN Files
    File.ReadFromCSVFile.ReadCSV CSVFile: CurrentItem Encoding: File.CSVEncoding.UTF8 TrimFields: True FirstLineContainsColumnNames: True ColumnsSeparator: File.CSVColumnsSeparator.SystemDefault CSVTable=> CSVTable
    File.GetPathPart File: CurrentItem RootPath=> RootPath Directory=> Directory FileName=> FileName FileNameWithoutExtension=> FileNameNoExtension Extension=> FileExtension
    Excel.GetFirstFreeColumnRow Instance: ExcelInstance FirstFreeColumn=> FirstFreeColumn FirstFreeRow=> FirstFreeRow
    Excel.WriteToExcel.WriteCell Instance: ExcelInstance Value: FileNameNoExtension Column: $'''A''' Row: FirstFreeRow
    SET LineItems TO CSVTable.RowsCount
    Excel.WriteToExcel.WriteCell Instance: ExcelInstance Value: LineItems Column: $'''B''' Row: FirstFreeRow
    IF LineItems = 0 THEN
        Logging.LogMessage Message: $'''%FileName% has no line items''' LogLevel: Logging.LogLevel.InfoLevel
    ELSE
        Variables.AddItemToList Item: FileNameNoExtension List: Summary
        Variables.IncreaseVariable Value: InvoiceCount IncrementValue: 1
    END
END
Text.JoinText.JoinWithDelimiter List: Summary StandardDelimiter: Text.StandardDelimiter.NewLine DelimiterTimes: 1 Result=> JoinedText
Excel.CloseExcel.CloseAndSaveAs Instance: ExcelInstance XmlMapName: $'''''' DocumentPath: $'''C:\Reports\\%FormattedDateTime%\Invoice summary.xlsx''' DocumentFormat: Excel.ExcelFormat.FromExtension
Compression.ZipFiles ArchivePath: $'''C:\Reports\\%FormattedDateTime%\Invoices.zip''' FilesOrFoldersToZip: Files CompressionLevel: Compression.CompressionLevel.BestBalanceOfSpeedAndCompression ArchiveComment: $'''''' Password: $'''''' ZipFile=> ZipFile
Display.ShowMessageDialog.ShowMessage Icon: Display.Icon.Information Buttons: Display.Buttons.OK DefaultButton: Display.DefaultButton.Button1 IsTopMost: False Message: $'''%InvoiceCount% invoices summarised: %JoinedText%''' Title: $'''Monthly invoice report''' ButtonPressed=> ButtonPressed
